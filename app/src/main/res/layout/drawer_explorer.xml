<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#252526"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EXPLORER"
        android:textColor="#BBBBBB"
        android:textSize="13sp"
        android:letterSpacing="0.05"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingBottom="8dp">

        <ImageButton android:id="@+id/btnNewFile"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_new_file" android:tint="#CCCCCC"
            android:contentDescription="New file"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/btnNewFolder"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_new_folder" android:tint="#CCCCCC"
            android:contentDescription="New folder"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/btnRefresh"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_refresh" android:tint="#CCCCCC"
            android:contentDescription="Refresh"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <ImageButton android:id="@+id/btnCollapse"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_collapse_all" android:tint="#CCCCCC"
            android:contentDescription="Collapse all"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#3A3A3A" />

    <TextView
        android:id="@+id/openHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OPEN EDITORS"
        android:textColor="#BBBBBB"
        android:textSize="12sp"
        android:letterSpacing="0.05"
        android:padding="12dp" />

    <LinearLayout
        android:id="@+id/openEditors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#3A3A3A" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WORKSPACE"
        android:textColor="#BBBBBB"
        android:textSize="12sp"
        android:letterSpacing="0.05"
        android:padding="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
